"""
Módulo sofisticado de Percepção com processamento de imagem avançado.
Implementa OCR, template matching e análise visual.
"""

import os
import subprocess
from pathlib import Path
from typing import Optional, Tuple, List
import asyncio

import pytesseract
import pyautogui
import cv2
import numpy as np
from PIL import Image, ImageEnhance, ImageFilter

from .base import Perception, Result
from .config import get_config
from .logging_module import get_logger, PerformanceTracker

pytesseract.pytesseract.tesseract_cmd = r"C:\Users\A21057836\AppData\Local\Programs\Tesseract-OCR\tesseract.exe"

class ImagePreprocessor:
    """Preprocessador de imagem para melhorar OCR."""
    
    def __init__(self, scale: float = 1.5, use_threshold: bool = True):
        self.scale = scale
        self.use_threshold = use_threshold
        self.logger = get_logger("ImagePreprocessor")
    
    def preprocess(self, image: np.ndarray) -> np.ndarray:
        """
        Preprocessa imagem para melhorar OCR.
        
        Args:
            image: Array numpy da imagem
            
        Returns:
            Imagem preprocessada
        """
        try:
            # Aumenta resolução
            if self.scale > 1.0:
                height, width = image.shape[:2]
                new_width = int(width * self.scale)
                new_height = int(height * self.scale)
                image = cv2.resize(image, (new_width, new_height))
            
            # Converte para escala de cinza
            if len(image.shape) == 3:
                gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
            else:
                gray = image
            
            # Aplica threshold se configurado
            if self.use_threshold:
                _, gray = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
            else:
                # Aplica contrast enhancement
                clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
                gray = clahe.apply(gray)
            
            return gray
        except Exception as e:
            self.logger.error(f"Erro ao preprocessar imagem: {e}")
            return image


class PerceptionImpl(Perception):
    """Implementação sofisticada do módulo de Percepção."""
    
    def __init__(self):
        super().__init__("Perception")
        self.config = get_config()
        self.logger = get_logger("Perception")
        self._setup_tesseract()
        self.preprocessor = ImagePreprocessor(
            scale=self.config.perception.preprocessing_scale,
            use_preprocessing=self.config.perception.use_preprocessing
        )
    
    def _setup_tesseract(self) -> None:
        """Configura caminho do Tesseract."""
        tesseract_path = self.config.perception.tesseract_path
        
        if tesseract_path:
            pytesseract.pytesseract.tesseract_cmd = tesseract_path
            self.logger.info(f"Tesseract configurado em: {tesseract_path}")
            return
        
        # Tenta encontrar automaticamente
        possible_paths = [
            r'C:\Program Files\Tesseract-OCR\tesseract.exe',
            r'C:\Program Files (x86)\Tesseract-OCR\tesseract.exe',
            r'C:\Tesseract-OCR\tesseract.exe',
        ]
        
        for path in possible_paths:
            if os.path.exists(path):
                pytesseract.pytesseract.tesseract_cmd = path
                self.logger.info(f"Tesseract encontrado em: {path}")
                return
        
        # Tenta via PATH
        try:
            result = subprocess.run(['where', 'tesseract'], capture_output=True, text=True)
            if result.returncode == 0:
                path = result.stdout.strip().split('\n')[0]
                pytesseract.pytesseract.tesseract_cmd = path
                self.logger.info(f"Tesseract encontrado via PATH: {path}")
                return
        except Exception:
            pass
        
        self.logger.warning("Tesseract-OCR não foi encontrado. OCR será limitado.")
    
    async def initialize(self) -> Result[None]:
        """Inicializa o módulo de percepção."""
        try:
            # Testa captura de tela
            screenshot = await self.capture_screen()
            if not screenshot.success:
                return Result.error("Falha ao capturar tela na inicialização")
            
            self.initialized = True
            self.logger.info("Módulo de Percepção inicializado com sucesso")
            return Result.ok(None)
        except Exception as e:
            return Result.error(f"Erro ao inicializar Percepção: {e}")
    
    async def shutdown(self) -> Result[None]:
        """Encerra o módulo de percepção."""
        self.initialized = False
        self.logger.info("Módulo de Percepção encerrado")
        return Result.ok(None)
    
    async def capture_screen(self, region: Optional[Tuple] = None) -> Result[np.ndarray]:
        """
        Captura a tela ou uma região.
        
        Args:
            region: Tuple (left, top, width, height) ou None para tela inteira
            
        Returns:
            Result contendo array numpy da imagem
        """
        try:
            screenshot = pyautogui.screenshot(region=region)
            img = np.array(screenshot)
            img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)
            
            self.logger.debug(f"Tela capturada: {img.shape}")
            return Result.ok(img)
        except Exception as e:
            return Result.error(f"Erro ao capturar tela: {e}")
    
    async def read_text(self, region: Optional[Tuple] = None) -> Result[str]:
        """
        Captura texto da tela usando OCR.
        
        Args:
            region: Região opcional (left, top, width, height)
            
        Returns:
            Result contendo texto extraído
        """
        with PerformanceTracker(self.logger, "OCR"):
            try:
                # Captura tela
                result = await self.capture_screen(region)
                if not result.success:
                    return result
                
                img = result.data
                
                # Preprocessa se habilitado
                if self.config.perception.use_preprocessing:
                    img = self.preprocessor.preprocess(img)
                
                # Executa OCR
                lang = self.config.perception.ocr_lang
                try:
                    text = pytesseract.image_to_string(img, lang=lang)
                except Exception as e:
                    self.logger.warning(f"Erro no OCR: {e}, usando fallback")
                    text = ""
                
                text = text.strip()
                
                if text:
                    self.logger.debug(f"Texto extraído: {len(text)} caracteres")
                else:
                    self.logger.debug("Nenhum texto detectado na tela")
                
                return Result.ok(text)
            except Exception as e:
                return Result.error(f"Erro ao ler texto: {e}")
    
    async def find_element(
        self,
        template_path: str,
        threshold: float = 0.8
    ) -> Result[Optional[Tuple[int, int]]]:
        """
        Encontra um elemento na tela usando template matching.
        
        Args:
            template_path: Caminho do template (imagem)
            threshold: Threshold de correspondência
            
        Returns:
            Result contendo (x, y) do centro ou None
        """
        try:
            # Carrega template
            template = cv2.imread(template_path)
            if template is None:
                return Result.error(f"Template não encontrado: {template_path}")
            
            # Captura tela
            result = await self.capture_screen()
            if not result.success:
                return result
            
            screen = result.data
            
            # Template matching
            result_match = cv2.matchTemplate(screen, template, cv2.TM_CCOEFF_NORMED)
            min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(result_match)
            
            if max_val >= threshold:
                h, w = template.shape[:2]
                center_x = max_loc[0] + w // 2
                center_y = max_loc[1] + h // 2
                
                self.logger.info(
                    f"Elemento encontrado",
                    confidence=round(max_val, 3),
                    position=(center_x, center_y)
                )
                return Result.ok((center_x, center_y))
            
            self.logger.debug(
                f"Elemento não encontrado (max_confidence: {max_val:.3f})"
            )
            return Result.ok(None)
        except Exception as e:
            return Result.error(f"Erro ao procurar elemento: {e}")
    
    async def analyze_colors(
        self,
        region: Optional[Tuple] = None
    ) -> Result[dict]:
        """
        Analisa cores dominantes em uma região.
        
        Args:
            region: Região opcional
            
        Returns:
            Result contendo análise de cores
        """
        try:
            result = await self.capture_screen(region)
            if not result.success:
                return result
            
            img = result.data
            
            # Converte para HSV
            hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
            
            # Calcula histograma
            hist = cv2.calcHist(
                [hsv],
                [0],
                None,
                [256],
                [0, 256]
            )
            
            # Encontra cor dominante
            dominant_hue = np.argmax(hist)
            
            analysis = {
                'dominant_hue': int(dominant_hue),
                'image_shape': img.shape,
                'pixel_count': img.shape[0] * img.shape[1]
            }
            
            return Result.ok(analysis)
        except Exception as e:
            return Result.error(f"Erro ao analisar cores: {e}")
    
    async def detect_edges(
        self,
        region: Optional[Tuple] = None
    ) -> Result[np.ndarray]:
        """
        Detecta bordas usando Canny.
        
        Args:
            region: Região opcional
            
        Returns:
            Result contendo imagem de bordas
        """
        try:
            result = await self.capture_screen(region)
            if not result.success:
                return result
            
            img = result.data
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            
            # Detecção de bordas
            edges = cv2.Canny(gray, 100, 200)
            
            return Result.ok(edges)
        except Exception as e:
            return Result.error(f"Erro ao detectar bordas: {e}")
    
    async def get_screen_metadata(self) -> Result[dict]:
        """
        Retorna metadados sobre a tela.
        
        Returns:
            Result contendo dimensões e informações
        """
        try:
            result = await self.capture_screen()
            if not result.success:
                return result
            
            img = result.data
            height, width = img.shape[:2]
            
            metadata = {
                'width': width,
                'height': height,
                'resolution_ratio': f"{width}x{height}",
                'aspect_ratio': round(width / height, 2),
                'total_pixels': width * height
            }
            
            return Result.ok(metadata)
        except Exception as e:
            return Result.error(f"Erro ao obter metadados: {e}")
