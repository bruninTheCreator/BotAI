import os
import json
from typing import Optional

try:
    class Planner:
        """Fallback Planner (dummy) para permitir importação do pacote durante correções.

        Este arquivo é intencionalmente simples: fornece a API mínima esperada
        pelo restante do sistema. Substituir por implementação completa quando
        as dependências estiverem instaladas.
        """

        def __init__(self, memory=None):
            self.memory = memory

        def interpret_command(self, command: str, screen_context: str = ""):
            cmd_lower = command.strip().lower()
            if not cmd_lower:
                return []
            if "youtube" in cmd_lower:
                return [{"action": "browse", "url": "https://www.youtube.com"}]
            if "salve" in cmd_lower or "salvar" in cmd_lower:
                return [{"action": "hotkey", "keys": ["ctrl", "s"]}]
            if "abrir" in cmd_lower or "abra" in cmd_lower:
                words = cmd_lower.split()
                if len(words) >= 2:
                    return [{"action": "open_app", "target": words[-1]}]
            return []
                                api_key = os.getenv("OPENAI_API_KEY")
                                self.client = OpenAI(api_key=api_key)
                            except Exception as e:
                                print(f"Aviso: Não foi possível inicializar o cliente OpenAI: {e}")

                    def interpret_command(self, command: str, screen_context: str = ""):
                        """Gera um plano de ação a partir de um comando de usuário.

                        Retorna lista de passos/ações (dicionários).
                        """
                        # Se o cliente OpenAI não estiver inicializado, usamos modo DEMO
                        if not self.client:
                            cmd_lower = command.strip().lower()

                            if cmd_lower in ("oi", "olá", "ola", "hello", "obrigado"):
                                return []

                            if "youtube" in cmd_lower or "abra o youtube" in cmd_lower or "abra youtube" in cmd_lower:
                                return [{"action": "browse", "url": "https://www.youtube.com"}]

                            if "salve" in cmd_lower or "salvar" in cmd_lower or "salve o arquivo" in cmd_lower:
                                return [{"action": "hotkey", "keys": ["ctrl", "s"]}]

                            if "ctrl+" in cmd_lower or "ctrl +" in cmd_lower:
                                part = cmd_lower.replace(" ", "")
                                if "ctrl+" in part:
                                    keys = part.split("ctrl+")[-1]
                                    keys_list = ["ctrl"] + keys.split("+")
                                    return [{"action": "hotkey", "keys": keys_list}]

                            if "abrir" in cmd_lower or "abra" in cmd_lower:
                                words = cmd_lower.split()
                                if len(words) >= 2:
                                    target = words[-1]
                                    return [{"action": "open_app", "target": target}]

                            # fallback
                            return []

                        # Quando há cliente OpenAI, montar prompt com histórico da memória
                        context_data = self.memory.load_all()
                        recent_context = context_data[-10:] if len(context_data) > 10 else context_data

                        history_lines = []
                        for event in recent_context:
                            event_type = event.get("event_type", "")
                            data = event.get("data", {})
                            if event_type == "user_command":
                                history_lines.append(f"Usuário: {data.get('command', '')}")
                            elif event_type == "execution_result":
                                action = data.get("action", "")
                                result = data.get("result", "")
                                history_lines.append(f"Executou '{action}': {result}")

                        history = "\n".join(history_lines) if history_lines else "Nenhum histórico anterior."

                        prompt = (
                            f"Você é um assistente de automação para tarefas de escritório (Windows).\n"
                            f"Comando do usuário: \"{command}\"\n\n"
                            f"Contexto da tela (OCR):\n{screen_context if screen_context else 'Nenhum texto capturado.'}\n\n"
                            f"Histórico:\n{history}\n\n"
                            "Responda SOMENTE com JSON no formato: {\"plan\": [...], \"response\": \"mensagem opcional\"}\n"
                            "Ações válidas: open_app, type_text, hotkey, browse, click\n"
                        )

                        try:
                            response = self.client.chat.completions.create(
                                model="gpt-4o-mini",
                                messages=[{"role": "user", "content": prompt}],
                                temperature=0.3,
                            )
                            text = response.choices[0].message.content
                            plan_data = json.loads(text)
                            return plan_data.get("plan", [])
                        except Exception as e:
                            print(f"Erro ao gerar o plano via OpenAI: {e}")
                            return []
